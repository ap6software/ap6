                panel Opt4Selected  { Left = 0; Top = 0; Width = 612; Height = 54; BackgroundColor = 120; }
                panel Opt4Correct   { Left = 0; Top = 0; Width = 612; Height = 54; BackgroundColor = 33; }
                panel Opt4Incorrect { Left = 0; Top = 0; Width = 612; Height = 54; BackgroundColor = 13; }
