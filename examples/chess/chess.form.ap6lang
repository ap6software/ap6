// chess.form.ap6lang -- the AP6 Chess board: the tree only, every
// object named, nothing computed. Compiled with the logic last:
//
//     ap6-compile chess.ap6 chess.form.ap6lang chess.logic.ap6lang
//
// THE BOARD is 64 squares Q0..Q63 in the chess service's square order
// (0 = a1, 7 = h1, 56 = a8, 63 = h8), white at the bottom: square n
// sits at Left = (n mod 8) * 60, Top = (7 - n div 8) * 60. Each square
// is a coloured panel holding three children, bottom to top:
//   V<n>  the piece picture, 20 x 60 centred -- the AP6.GamesResources
//         chess pictures are 221 x 664 with the piece standing on the
//         bottom edge, so the square's full height at the true aspect
//         keeps a king tall and a pawn short; Image 0 = empty, a piece
//         is 3999 + its service code;
//   P<n>  the click target, the whole square, Image 0 (it draws
//         nothing and takes the pointer everywhere in the square);
//   M<n>  the marker label the logic writes into (a target dot, the
//         selected diamond, or nothing). A label never takes the
//         pointer, so every click on a square arrives from P<n> and the
//         logic looks the square up in Hits.
//
// THE SIDE PANEL carries the turn, the game state, the level buttons
// (the four published levels of AP6ChessCore.h -- no Expert), New
// Game, and the computer's last move with its search figures. There
// is no Cancel: the search is bounded by the level's node budget and
// nothing could stop it (design 3.4).

panel Board { Left = 0; Top = 0; Width = 480; Height = 480; BackgroundColor = 4;
    panel Q0 { Left = 0; Top = 420; Width = 60; Height = 60; BackgroundColor = 2;
        image V0 { Left = 20; Top = 0; Width = 20; Height = 60; Image = 0; }
        image P0 { Left = 0; Top = 0; Width = 60; Height = 60; Image = 0; }
        label M0 { Left = 0; Top = 0; Width = 60; Height = 60; Text = ""; TextAlign = 1; FontId = 1; TextColor = 46; }
    }
    panel Q1 { Left = 60; Top = 420; Width = 60; Height = 60; BackgroundColor = 11;
        image V1 { Left = 20; Top = 0; Width = 20; Height = 60; Image = 0; }
        image P1 { Left = 0; Top = 0; Width = 60; Height = 60; Image = 0; }
        label M1 { Left = 0; Top = 0; Width = 60; Height = 60; Text = ""; TextAlign = 1; FontId = 1; TextColor = 46; }
    }
    panel Q2 { Left = 120; Top = 420; Width = 60; Height = 60; BackgroundColor = 2;
        image V2 { Left = 20; Top = 0; Width = 20; Height = 60; Image = 0; }
        image P2 { Left = 0; Top = 0; Width = 60; Height = 60; Image = 0; }
