// game1.logic.ap6lang -- GAME1's logic (visual/playable checkpoint,
// Phase 4.0; split from the form in Phase 4.1B), written in the AP6
// Language: the room-choice page and Room 1 of DEMOFORM, transcribed
// from Unit1.pas (TRoomSelect.FormMessage, TRoom1.FormMessage), FROOMA.pas
// and FROOM1.pas of the original Delphi game
// (read only), playing the authentic BUT/ANM/BK artwork the offline
// importer converted into AP6.GamesResources (IDs 5000..5101).
//
// THIS IS NOT THE COMPLETE MIGRATION. Approved as the first visible
// checkpoint (decision I): the game is SILENT and has NO QUIZ DRAW --
// every sound's completion code is emitted at once (as Phase 1 did), the
// AVI, the spoken hints, the random object draw and its timer blink are
// not here. The original requirements are preserved in the migration
// record (AP6_LANGUAGE_PHASE4_0_REPORT.md, "Excluded, not deleted");
// nothing of the legacy code or data was removed.
//
// THREE SOURCE FILES, ONE PROJECT (Phase 4.1B): game1.resources.ap6lang
// (GENERATED by tools/AP6.Legacy.Import: every size, frame ID, frame
// time and anchor of the legacy files) comes FIRST on the ap6-compile
// command line; game1.form.ap6lang (the tree, OWNED BY AP6.EDITOR and
// printed whole on every save) second; this file, the logic, last. A
// diagnostic names the file and the line in it. This file is the one
// hand-written source: every comment belongs here, since the form file
// keeps only its header comment.
//
// THE TREE follows the legacy paint order exactly (CUSTOB~1.PAS PaintSys
// paints the control list from its last entry to its first, MYLIST.PAS
// groups the list by NumList then creation order): in AP6 a later child
// paints over an earlier one, so each page lists its children bottom to
// top. ONE DELIBERATE MOVE: Room1's H5 (6H.BUT) is declared ABOVE the box
// panel rather than beneath it. In the original the box panel and its
// animation take no pointer input (TMyAnim.FindObject is false, the
// panel's FindObject is false) so H5 could be clicked through them; an
// AP6 panel and image are hit targets, so H5 is placed above them. The
// picture is identical: no box frame has an opaque pixel inside H5's
// rectangle (checked by the importer's frames; see the report).
//
// HIT TESTING IS THE ORIGINAL'S (Phase 4.0B): every button's image
// declares PointerMaskImage = the resource of its TFindBitmap (the
// _MASK declarations), so a click or a hover lands exactly where the
// Delphi mask took it -- a transparent corner passes to the object
// behind. The mask is a separate resource: the frames a button shows
// never move its clickable area. The backgrounds, the box and the
// walker have none (the original's animations took no pointer).
//
// CODES are the original fmButton / fmAnim / fmShow / fmSound numbers,
// per page: RoomSelect 30000 + n, Room1 40000 + n; kind bases fmButton
// 0, fmAnim 1000, fmShow 2000, fmSound 5000. Phase 4.0 adds two internal
// bands that the original expressed as object state rather than as
// messages: +7000 + n is "button n's OnClick list has played" (the
// reaction fires from it, as DoClick fired after the list), and +1900..
// +1909 are the picture loops (hover, exit walk) re-issued from their
// completion.

// ====================================================================
// The tree
// ====================================================================

// TRoomSelect / FROOMA.pas. Bottom to top: background, CMyButton0
// (ROOMA\BUT1.BUT -> 201), CMyButton1 (ROOMA\BUT2.BUT -> 202), BExit
// (MAIN1\BEXIT.BUT), AExit (MAIN1\EANIM.ANM).
// The tree is game1.form.ap6lang (AP6.Editor-owned, Phase 4.1B); its
// header comment explains the paint order and names every object.


// ====================================================================
// State
// ====================================================================

// THE APPLICATION STATE a save carries (Phase 3.0): which page is shown,
// TFormGame.NRama (0 free play from button 201, 1 the quiz from 202) and
// Rama (the room: 0 is Room1; rooms 1 and 2 are not in this checkpoint),
// and where each of the thirteen objects is. Reloading shows the saved
// page as it was -- without replaying fmShow, which would put every
// object back in the room.
persisted number Page = 0;
persisted number NRama = 0;
persisted number Rama = 0;
persisted mutable bool[] InBox = [false, false, false, false, false, false, false, false, false, false, false, false, false];

// TRoom1.Buts[0..12] (in the room) and Buts[13..25] (in the box), by
// object index; the room-choice buttons; each page's exit pair, page 0
// RoomSelect, page 1 Room1.
ref[] RoomItems = [H0, H1, H2, H3, H4, H5, H6, H7, H8, H9, H10, H11, H12];
ref[] BoxItems = [B0, B1, B2, B3, B4, B5, B6, B7, B8, B9, B10, B11, B12];
ref[] RoomButtons = [But1, But2];
ref[] Pages = [RoomSelect, Room1];
ref[] AExits = [RoomSelect.AExit, Room1.AExit];
ref[] BExits = [RoomSelect.BExit, Room1.BExit];
number[] PageBase = [30000, 40000];

// Pointer state the pictures depend on (the original kept it inside
// each TMyButton): which objects and exits the pointer is over, and
// whether an exit is walking (its frames loop while it does).
mutable bool[] RoomHover = [false, false, false, false, false, false, false, false, false, false, false, false, false];
mutable bool[] BoxHover = [false, false, false, false, false, false, false, false, false, false, false, false, false];
mutable bool[] ExitHover = [false, false];
mutable bool[] Walking = [false, false];

// TRoom1.FPosS: the two completions fmShow waits for before the room
// takes input (sound 7 -> 101 -> fmAnim 200, and the box's own 200).
number FPosS = 0;

// AExit.PlayTo(self.width + 30, AExit.top, 1, 0, true, true, 100): the
// exit walks right by M1_EANIM_PEGX (10) per tick from Left 5 until its
// reference point Left + M1_EANIM_COORX (94) reaches 670 -- 58 ticks,
// Left 585, 58 x 50 = 2900 ms -- cycling animation 0's 13 frames.
number ExitWalkMs = 2900;
number ExitWalkLeft = 585;

// ====================================================================
// Procedures
// ====================================================================

// fmShow's exit pair: BExit.MoveObjectTo(5, top); AExit.visible :=
// false; AExit.MoveObjectTo(5, top); BExit.visible := true.
void ShowExits(number page)
{
    BExits[page].Left = 5;
    AExits[page].Visible = false;
    AExits[page].Left = 5;
    BExits[page].Visible = true;
    BExits[page].Image = M1_BEXIT_CUSTOM[0];
}

// fmButton 300: AExit.visible := true; BExit.visible := false;
// MouseEnabled := false; PlaySound(6, true, 0); AExit.PlayTo(..., 100).
// The sound has no completion the game waits for (code 0).
void LeaveExits(number page)
{
    AExits[page].Visible = true;
    BExits[page].Visible = false;
    ExitHover[page] = false;
    ExitRest(page);
    Walking[page] = true;
    Lock(Pages[page], untilCode: PageBase[page] + 1100);
    Tween(AExits[page], duration: ExitWalkMs, code: PageBase[page] + 1100) { Left = ExitWalkLeft; }
    Sequence(AExits[page], images: M1_EANIM_A0, frameTime: M1_EANIM_A0_MS, code: PageBase[page] + 1905);
}

// Buts[i + 13].visible := true; Buts[i].visible := false -- and back.
void MoveToBox(number index)
{
    BoxItems[index].Visible = true;
    RoomItems[index].Visible = false;
    InBox[index] = true;
}

void MoveToRoom(number index)
{
    RoomItems[index].Visible = true;
    BoxItems[index].Visible = false;
    InBox[index] = false;
}

// The exit button's InMouse list is ten frames that cycle while the
// pointer stays; leaving shows the Custom picture again (a one-frame
// sequence replaces the loop, so no later frame of it can show).
void ExitHoverLoop(number page)
{
    Sequence(BExits[page], images: M1_BEXIT_HOVER, frameTime: M1_BEXIT_HOVER_MS, code: PageBase[page] + 1901);
}

void ExitRest(number page)
{
    Sequence(BExits[page], images: M1_BEXIT_CUSTOM, frameTime: M1_BEXIT_CUSTOM_MS, code: PageBase[page] + 1902);
}

// ====================================================================
// Load
// ====================================================================

// The saved page, as saved. Page 0 is fmShow's RoomSelect; page 1 is
// Room1 with its objects where they were and the box already open.
on Load
{
    if (Page == 1)
    {
        for (number i = 0; i < RoomItems.Count; i = i + 1)
        {
            RoomItems[i].Visible = !InBox[i];
            BoxItems[i].Visible = InBox[i];
        }

        Room1.Box.Anim.Image = R1_BOX_A1[26];
        ShowExits(1);
        Room1.Visible = true;
        RoomSelect.Visible = false;
    }
    else
    {
        Emit(32000);
        RoomSelect.Visible = true;
        Room1.Visible = false;
    }
}

// ====================================================================
// The pointer over the pictures (BUT states 1 InMouse, 2 Down)
// ====================================================================

// The two room buttons have one picture: their InMouse and Down lists
// show the Custom picture, so only the exit changes.
on RoomSelect.Enter(ref source)
{
    if (source == RoomSelect.BExit) { ExitHover[0] = true; ExitHoverLoop(0); }
}

on RoomSelect.Leave(ref source)
{
    if (source == RoomSelect.BExit) { ExitHover[0] = false; ExitRest(0); }
}

on RoomSelect.Down(ref source)
{
    if (source == RoomSelect.BExit) Sequence(RoomSelect.BExit, images: M1_BEXIT_DOWN, frameTime: M1_BEXIT_DOWN_MS, code: 31903);
}

on RoomSelect.Up(ref source)
{
    if (source == RoomSelect.BExit)
    {
        if (ExitHover[0]) ExitHoverLoop(0); else ExitRest(0);
    }
}

on Room1.Enter(ref source)
{
    if (source == Room1.BExit) { ExitHover[1] = true; ExitHoverLoop(1); }

    for (number i = 0; i < RoomItems.Count; i = i + 1)
    {
        if (source == RoomItems[i]) { RoomHover[i] = true; RoomItems[i].Image = R1_H_HOVER[i]; }
        if (source == BoxItems[i]) { BoxHover[i] = true; BoxItems[i].Image = R1_B_HOVER[i]; }
    }
}

on Room1.Leave(ref source)
{
    if (source == Room1.BExit) { ExitHover[1] = false; ExitRest(1); }

    for (number i = 0; i < RoomItems.Count; i = i + 1)
    {
        if (source == RoomItems[i]) { RoomHover[i] = false; RoomItems[i].Image = R1_H_CUSTOM[i]; }
        if (source == BoxItems[i]) { BoxHover[i] = false; BoxItems[i].Image = R1_B_CUSTOM[i]; }
    }
}

on Room1.Down(ref source)
{
    if (source == Room1.BExit) Sequence(Room1.BExit, images: M1_BEXIT_DOWN, frameTime: M1_BEXIT_DOWN_MS, code: 41903);

    for (number i = 0; i < RoomItems.Count; i = i + 1)
    {
        if (source == RoomItems[i]) RoomItems[i].Image = R1_H_DOWN[i];
        if (source == BoxItems[i]) BoxItems[i].Image = R1_B_DOWN[i];
    }
}

on Room1.Up(ref source)
{
    if (source == Room1.BExit)
    {
        if (ExitHover[1]) ExitHoverLoop(1); else ExitRest(1);
    }

    for (number i = 0; i < RoomItems.Count; i = i + 1)
    {
        if (source == RoomItems[i])
        {
            if (RoomHover[i]) RoomItems[i].Image = R1_H_HOVER[i]; else RoomItems[i].Image = R1_H_CUSTOM[i];
        }

        if (source == BoxItems[i])
        {
            if (BoxHover[i]) BoxItems[i].Image = R1_B_HOVER[i]; else BoxItems[i].Image = R1_B_CUSTOM[i];
        }
    }
}

// ====================================================================
// Clicks: the OnClick list plays through, THEN the reaction (MYBUTS.PAS
// DrawObject: DoClick fires when the list's last frame has shown)
// ====================================================================

on RoomSelect.Click(ref source)
{
    for (number i = 0; i < RoomButtons.Count; i = i + 1)
    {
        if (source == RoomButtons[i])
            Sequence(RoomButtons[i], images: [RA_BUT_CLICK[i]], frameTime: RA_BUT_CLICK_MS[i], code: 37201 + i);
    }

    if (source == RoomSelect.BExit)
        Sequence(RoomSelect.BExit, images: M1_BEXIT_CLICK, frameTime: M1_BEXIT_CLICK_MS, code: 37300);
}

on Room1.Click(ref source)
{
    for (number i = 0; i < RoomItems.Count; i = i + 1)
    {
        if (source == RoomItems[i])
            Sequence(RoomItems[i], images: [R1_H_CLICK[i]], frameTime: R1_H_CLICK_MS[i], code: 47200 + i);

        if (source == BoxItems[i])
            Sequence(BoxItems[i], images: [R1_B_CLICK[i]], frameTime: R1_B_CLICK_MS[i], code: 47100 + i);
    }

    if (source == Room1.BExit)
        Sequence(Room1.BExit, images: M1_BEXIT_CLICK, frameTime: M1_BEXIT_CLICK_MS, code: 47300);
}

// ====================================================================
// The messages (TRoomSelect.FormMessage, TRoom1.FormMessage)
// ====================================================================

// ---- TRoomSelect -----------------------------------------------------

// fmShow.
on Code(32000) { ShowExits(0); }

// fmButton 300: leave; fmAnim 100 returns to Main2 in DEMOFORM, which
// this checkpoint does not hold, so leaving the room choice closes the
// application (the Phase-1 reduction, kept).
on Code(30300) { LeaveExits(0); }
on Code(31100) { Walking[0] = false; AExits[0].Visible = false; Close(); }

// ---- TRoom1 ----------------------------------------------------------

// fmShow: every object back in the room; the exit pair; MouseEnabled :=
// false until both completions (FPosS = 2); PlaySound(7, true, 101) --
// silent, so 101 arrives at once; CMyAnim1.Play(1, false, true, 200): the
// box opens through animation 1's 27 frames, then 200.
on Code(42000)
{
    for (number i = 0; i < RoomItems.Count; i = i + 1)
        MoveToRoom(i);

    ShowExits(1);
    FPosS = 0;
    Lock(Room1, untilCode: 45102);
    Emit(45101);
    Sequence(Room1.Box.Anim, images: R1_BOX_A1, frameTime: R1_BOX_A1_MS, code: 41200);
}

// fmSound 101: SendMyMessage(fmAnim, 200).
on Code(45101) { Emit(41200); }

// fmAnim 200: inc(FPosS); if FPosS >= 2 then PlaySound(70, true, 102).
on Code(41200)
{
    FPosS = FPosS + 1;

    if (FPosS >= 2)
        Emit(45102);
}

// fmSound 102: if NRama = 1 then the quiz draw (RandomQ, the object's
// name, then fmSound 1) else MouseEnabled := true. The draw is not in
// this checkpoint; in both modes the lock ends here.
on Code(45102) { }

// fmAnim 100 (the exit walked out): AExit.visible := false;
// SendMyMessage(fmSound, 1000). fmSound 1000: back to the room choice
// (the AVI is not here); MouseEnabled := true.
on Code(41100) { Walking[1] = false; AExits[1].Visible = false; Emit(46000); }

on Code(46000)
{
    Page = 0;
    Emit(32000);
    RoomSelect.Visible = true;
    Room1.Visible = false;
}

// fmSound 1 (after a box object went back to the room): MouseEnabled :=
// true. fmSound 2 (after a room object went into the box): if NRama = 1
// then the next draw, else if any object is still in the room then
// MouseEnabled := true else fmButton 301 (the AVI) -- neither is here.
on Code(45001) { }
on Code(45002) { }

// ---- codes with a parameter ----------------------------------------

on Code(n)
{
    // The picture loops: the exit's InMouse list while the pointer stays;
    // the exit walk's frames while it walks.
    if (n == 31901 && ExitHover[0]) ExitHoverLoop(0);
    if (n == 41901 && ExitHover[1]) ExitHoverLoop(1);
    if (n == 31905 && Walking[0]) Sequence(AExits[0], images: M1_EANIM_A0, frameTime: M1_EANIM_A0_MS, code: 31905);
    if (n == 41905 && Walking[1]) Sequence(AExits[1], images: M1_EANIM_A0, frameTime: M1_EANIM_A0_MS, code: 41905);

    // A button's OnClick list has played: the button shows its state
    // again (InMouse while the pointer stays, else Custom), then the
    // reaction, as DoClick.
    if (n >= 37201 && n <= 37202) Emit(n - 7000);

    if (n == 37300)
    {
        if (ExitHover[0]) ExitHoverLoop(0); else ExitRest(0);
        Emit(30300);
    }

    if (n >= 47100 && n <= 47112)
    {
        if (BoxHover[n - 47100]) BoxItems[n - 47100].Image = R1_B_HOVER[n - 47100]; else BoxItems[n - 47100].Image = R1_B_CUSTOM[n - 47100];
        Emit(n - 7000);
    }

    if (n >= 47200 && n <= 47212)
    {
        if (RoomHover[n - 47200]) RoomItems[n - 47200].Image = R1_H_HOVER[n - 47200]; else RoomItems[n - 47200].Image = R1_H_CUSTOM[n - 47200];
        Emit(n - 7000);
    }

    if (n == 47300)
    {
        if (ExitHover[1]) ExitHoverLoop(1); else ExitRest(1);
        Emit(40300);
    }

    // fmButton 201, 202: NRama := n - 201; case Rama of 0: Room1 (1, 2:
    // rooms this checkpoint does not hold); a.SendMyMessage(fmShow);
    // a.visible := true; self.visible := false.
    if (n >= 30201 && n <= 30202)
    {
        NRama = n - 30201;

        if (Rama == 0)
        {
            Page = 1;
            Emit(42000);
            Room1.Visible = true;
            RoomSelect.Visible = false;
        }
    }

    // fmButton 300 in Room1: leave.
    if (n == 40300) LeaveExits(1);

    // fmButton 100..112 (an object in the box was clicked): if NRama = 1
    // then SoundError else MouseEnabled := false; PlaySound(3 + random(2),
    // true, 1); back to the room. fmButton 200..212 (an object in the room):
    // if NRama = 1 and it is not the drawn object then SoundError else
    // MouseEnabled := false; PlaySound(..., 2); into the box. Without the
    // draw, quiz mode refuses every object click (as Phase 1 did); the
    // sounds are silent, so their codes arrive at once and the lock of
    // the same commit is released by them.
    if (n >= 40100 && n <= 40112 && NRama != 1)
    {
        Lock(Room1, untilCode: 45001);
        MoveToRoom(n - 40100);
        Emit(45001);
    }

    if (n >= 40200 && n <= 40212 && NRama != 1)
    {
        Lock(Room1, untilCode: 45002);
        MoveToBox(n - 40200);
        Emit(45002);
    }
}
