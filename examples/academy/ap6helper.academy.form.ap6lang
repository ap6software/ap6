panel Root
{
    Left = 0; Top = 0; Width = 1280; Height = 800; BackgroundColor = 41;

    panel TopBar
    {
        Left = 0; Top = 0; Width = 1280; Height = 84;

        label Title    { Left = 24; Top = 12; Width = 600; Height = 32; TextAlign = -1; FontId = 3; TextColor = 48; TextFit = 0; }
        label Subtitle { Left = 24; Top = 48; Width = 700; Height = 22; TextAlign = -1; FontId = 0; TextColor = 48; TextFit = 0; }
        label Progress { Left = 900; Top = 24; Width = 356; Height = 28; TextAlign = 1; FontId = 0; TextColor = 48; TextFit = 0; }

        button LangRu { Left =  910; Top = 50; Width = 110; Height = 26; }
        button LangHe { Left = 1028; Top = 50; Width = 110; Height = 26; }
        button LangEn { Left = 1146; Top = 50; Width = 110; Height = 26; }
    }

    panel Rail
    {
        Left = 0; Top = 84; Width = 244; Height = 716;

